FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

SHELL ["/bin/bash", "-lc"]

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    git \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /workspace

COPY pyproject.toml /opt/fmad/pyproject.toml
COPY src/fmad /opt/fmad/src/fmad

RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install 'numpy<2' torch==2.2.2+cu118 torchvision==0.17.2+cu118 --extra-index-url https://download.pytorch.org/whl/cu118 && \
    python3 -m pip install 'numpy<2' faiss-gpu-cu11 '/opt/fmad[model]'

CMD ["/bin/bash"]
