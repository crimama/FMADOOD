# Non-secret PSMA_MR preset for the existing C1 dsba1 container.
# Load the ignored credential/SSH base first; never commit its values:
#   set +x; source configs/remote/dsba1.env
# Then load this file from the repository root.

export CONTAINER_NAME='hun_fsad_tta_c1_dsba1'
export REMOTE_WORKDIR='/workspace/fmad-ood-dsba1-c1'
export REMOTE_REPO_DIR='/workspace/fmad-ood-dsba1-c1'
export REMOTE_RESULTS_DIR='/workspace/results_remote/psma_mr_dsba1_c1'
export LOCAL_RESULTS_DIR="$PWD/results/remote_runs/dsba1_c1"
export REMOTE_DATA_ROOT='/home/hunim/Volume/DATA'
export LOCAL_DATA_ROOT='/home/hunim/Volume/DATA'

# Host GPU 6; this UUID is the device ID exposed by the container.
export REMOTE_GPU_DEVICES='GPU-59115c6a-8ccb-5474-72e3-67cdf2d363fd'

# Use the preloaded DINOv2 cache mounted in this container.
export TORCH_HOME='/workspace/.cache/torch'
export DINOV2_LOCAL_REPO='/workspace/.cache/torch/hub/facebookresearch_dinov2_main'
export FMAD_DINOV2_OFFLINE='1'
