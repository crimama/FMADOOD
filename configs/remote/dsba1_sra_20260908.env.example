# Non-secret PSMA_MR preset for the existing SRA container.
# Load the ignored credential/SSH base first; never commit its values:
#   set +x; source configs/remote/dsba1.env
# Then load this file from the repository root.

export CONTAINER_NAME='hun_fsad_tta_sra_20260908'
export REMOTE_WORKDIR='/workspace/fmad-ood-dsba1-sra'
export REMOTE_REPO_DIR='/workspace/fmad-ood-dsba1-sra'
export REMOTE_RESULTS_DIR='/workspace/results_remote/psma_mr_dsba1_sra'
export LOCAL_RESULTS_DIR="$PWD/results/remote_runs/dsba1_sra_20260908"
export REMOTE_DATA_ROOT='/home/hunim/Volume/DATA'
export LOCAL_DATA_ROOT='/home/hunim/Volume/DATA'

# Host GPU 0; this UUID is one of the device IDs exposed by the container.
export REMOTE_GPU_DEVICES='GPU-40a9f4d3-f585-9544-8209-359b2ec00252'

# Use the read-only, preloaded DINOv2 cache mounted in this container.
export TORCH_HOME='/workspace/.cache/torch'
export DINOV2_LOCAL_REPO='/workspace/.cache/torch/hub/facebookresearch_dinov2_main'
export FMAD_DINOV2_OFFLINE='1'
